
class Solution(object):
    def findTargetSumWays(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        dp = {0: 1}

        for num in nums:
            new_dp = {}

            for total, count in dp.items():
                plus = total + num
                minus = total - num

                new_dp[plus] = new_dp.get(plus, 0) + count
                new_dp[minus] = new_dp.get(minus, 0) + count

            dp = new_dp

        return dp.get(target, 0)
