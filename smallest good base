
class Solution(object):
    def smallestGoodBase(self, n):
        """
        :type n: str
        :rtype: str
        """
        num = int(n)

        max_power = num.bit_length()

        for m in range(max_power, 1, -1):
            left, right = 2, int(num ** (1.0 / (m - 1))) + 1

            while left <= right:
                k = (left + right) // 2

                total = 1
                for i in range(m):
                    total = total * k + 1 if i < m - 1 else total

                # Calculate 1 + k + k^2 + ... + k^(m-1)
                total = 1
                for i in range(1, m):
                    total = total * k + 1

                if total == num:
                    return str(k)
                elif total < num:
                    left = k + 1
                else:
                    right = k - 1

        return str(num - 1)
